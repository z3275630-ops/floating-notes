<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FloatingNotes" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/window_canvas</item>
    </style>

    <style name="Theme.FloatingNotes.Starting" parent="Theme.FloatingNotes">
        <item name="android:windowBackground">@drawable/launch_splash</item>
    </style>
</resources>
