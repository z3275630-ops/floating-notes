<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mint_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_review_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每日回顾"
            android:textColor="#187D52"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_review_privacy_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="隐私遮罩已开"
            android:textColor="#5C7A6B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_review_refresh"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_secondary_pill"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="刷新"
            android:textColor="#187D52"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_review_card_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_secondary_pill"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_review_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="今日待重温笔记"
            android:textColor="#11281E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_review_excerpt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="已启用隐私保护 · 点此进入原回顾会话查看"
            android:textColor="#476154"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_review_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="更新于刚刚"
            android:textColor="#5C7A6B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_review_btn_capture"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_mint_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="+ 写笔记"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
